@class

interface Repository {
  +find(id: UUID): Entity
  +save(entity: Entity): void
}

interface PaymentGateway {
  +authorize(amount: Money): Authorization
  +capture(id: UUID): Receipt
}

abstract AggregateRoot {
  #version: integer
  +record(event: DomainEvent): void
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

class Order {
  -id: UUID
  -status: OrderStatus
  -items: LineItem[]
  +addItem(product: Product, quantity: int): void
  +confirm(): void
  +total(): Money
}

class LineItem {
  -quantity: int
  -unitPrice: Money
  +subtotal(): Money
}

class OrderRepository {
  -database: Database
  +find(id: UUID): Order
  +save(order: Order): void
}

class CheckoutService {
  -orders: Repository
  -payments: PaymentGateway
  +checkout(orderId: UUID): Receipt
}

Order --|> AggregateRoot
Order "1" *-- "1..N" LineItem: items
Order --> OrderStatus: status
OrderRepository ..|> Repository
OrderRepository ..> Order: persists
CheckoutService ..> Repository: loads
CheckoutService ..> PaymentGateway: authorizes
CheckoutService ..> Order: confirms
