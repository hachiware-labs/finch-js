@er

entity tenants "Tenants" {
  id uuid pk
  slug varchar(80) unique
  name varchar(160)
  created_at timestamp
}

entity users "Users" {
  id uuid pk
  tenant_id uuid fk
  email varchar(255) unique
  display_name varchar(160)
  status user_status
}

entity products "Products" {
  id uuid pk
  tenant_id uuid fk
  sku varchar(64) unique
  name varchar(255)
  price decimal(12,2)
}

entity orders "Orders" {
  id uuid pk
  user_id uuid fk
  status order_status
  total decimal(12,2)
  placed_at timestamp
}

entity order_items "Order Items" {
  id uuid pk
  order_id uuid fk
  product_id uuid fk
  quantity integer
  unit_price decimal(12,2)
}

entity payments "Payments" {
  id uuid pk
  order_id uuid fk
  provider varchar(40)
  amount decimal(12,2)
  status payment_status
}

entity order_events "Order Events" {
  id uuid pk
  order_id uuid fk
  event_type varchar(80)
  payload jsonb
  occurred_at timestamp
}

tenants 1 -> many users: owns
tenants 1 -> many products: catalogs
users 1 -> many orders: places
orders 1 -> many order_items: contains
products 1 -> many order_items: referenced by
orders 1 -> 0..N payments: attempts
orders 1 -> many order_events: emits
