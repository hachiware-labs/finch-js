@flowchart

start begin "Request received"
input payload "Read payload"
process normalize "Normalize fields"
decision valid "Schema valid?"
process reject "Record validation error"
decision risk "Risk acceptable?"
process review "Manual review"
decision approved "Review approved?"
process execute "Execute transaction"
decision settled "Settlement complete?"
output receipt "Send receipt"
process compensate "Run compensation"
end success "Completed"
end failure "Rejected"

begin -> payload
payload -> normalize
normalize -> valid
valid -> risk: Yes
valid -> reject: No
reject -> failure
risk -> execute: Low risk
risk -> review: Review
review -> approved
approved -> execute: Yes
approved -> normalize: Retry
approved -> failure: No
execute -> settled
settled -> receipt: Yes
settled --> compensate: Timeout
compensate -> execute: Retry
compensate -> failure: Abort
receipt -> success
