@services

' tier controls the custom layout column; owner is drawn by service-card.
service browser "Web Client" [shape=browser-icon tier=edge owner=Experience]
service gateway "API Gateway" [shape=gateway-icon tier=edge owner=Platform]
service orders "Order Service" [tier=application owner=Commerce]
service billing "Billing Service" [shape=shield-icon tier=application owner=Finance]
service rewards "Rewards Service" [shape=star-icon tier=application owner=Experience]
service order-db "Order Database" [shape=database tier=data owner=Commerce]
service ledger "Ledger" [shape=document-stack tier=data owner=Finance]

browser -> gateway: HTTPS
gateway -> orders: Create order
gateway -> rewards: Earn points
orders -> billing: Authorize
orders -> order-db: Store order
billing -> ledger: Record charge
billing --> orders: Accepted
