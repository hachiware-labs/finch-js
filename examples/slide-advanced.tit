@slide

title "Tit.js — ideas become diagrams" [align=center]
subtitle "A concise DSL keeps the story structured, consistent, and editable." [align=center]

row journey [gap=76] {
  card source "Describe" [badge=STEP-1 body="Write the intent in a few readable lines."]
  arrow: Structure
  card compose "Compose" [badge=STEP-2 body="Rows, grids, and relationships arrange themselves." tone=accent]
  arrow: Refine
  card present "Present" [badge=STEP-3 body="Adjust only what needs a human touch."]
}

grid strengths [columns=3 gap=22] {
  card fast "Fast to author" [body="Less time aligning boxes and arrows."]
  card consistent "Visually consistent" [body="One theme governs spacing, type, and color."]
  card editable "Still editable" [body="Drag, pin, and preserve intentional changes."]
  note syntax "Readable source" [body="The diagram remains understandable in code review."]
  note export "SVG output" [body="Sharp enough for decks, documents, and the web."]
  note extensible "Open vocabulary" [body="Add more presentation patterns over time."]
}

callout outcome "Spend the meeting on the idea—not on aligning shapes." [body="Tit.js turns presentation structure into a reusable, versionable artifact." width=720]

row tags [gap=12] {
  badge docs "DOCUMENTATION"
  badge pitches "PITCHES"
  badge workshops "WORKSHOPS"
  badge reviews "DESIGN REVIEWS"
}
