@slide

title "Q2 product health" [align=center]
subtitle "Lead with the numbers that support one decision." [align=center]

row metrics [gap=18] {
  metric activation "72%" [label="Activation" delta="+8 pt vs Q1" tone=accent]
  metric teams "1,284" [label="Active teams" delta="+19% QoQ"]
  metric time "4.6 min" [label="Time to first diagram" delta="−31% vs Q1"]
}

callout decision "Double down on guided templates." [body="Activation improved most for teams that started from a representative example." width=760]
