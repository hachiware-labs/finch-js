@usecase

actor customer "Customer"
actor member "Registered Customer"
actor operator "Store Operator"
actor payments "Payment Provider"

system commerce "Commerce Platform" {
  usecase browse "Browse catalog"
  usecase checkout "Checkout"
  usecase authenticate "Authenticate"
  usecase coupon "Apply coupon"
  usecase pay "Authorize payment"
  usecase refund "Issue refund"
  usecase manage "Manage catalog"
}

generalize member -> customer
customer -> browse
customer -> checkout
member -> coupon
operator -> refund
operator -> manage
payments -> pay
include checkout -> authenticate
include checkout -> pay
extend coupon -> checkout
include refund -> authenticate
