{
  "name": "tit-js",
  "version": "0.1.0",
  "description": "Fast, beautiful, editable diagrams from concise text.",
  "homepage": "https://github.com/hachiware-labs/tit-js#readme",
  "bugs": {
    "url": "https://github.com/hachiware-labs/tit-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hachiware-labs/tit-js.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/tit.global.js"
  ],
  "main": "./dist/tit.js",
  "module": "./dist/tit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/tit.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/tit.global.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/browser.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "README_ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "dev": "node scripts/build.mjs --watch",
    "prepack": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "diagram",
    "svg",
    "dsl",
    "sequence-diagram",
    "deployment-diagram"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.25.9",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
