{
  "name": "tit-js",
  "version": "0.1.0",
  "description": "Fast, beautiful, editable diagrams from concise text.",
  "type": "module",
  "main": "./dist/tit.js",
  "module": "./dist/tit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tit.js"
    },
    "./browser": "./dist/tit.global.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "README_ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "diagram",
    "svg",
    "dsl",
    "sequence-diagram",
    "deployment-diagram"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.25.9",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
